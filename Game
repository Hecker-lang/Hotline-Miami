<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>Ultimate HTML5 Shooter – Enhanced (Dash Fix)</title>
  <style>
    body {
      margin: 0;
      overflow: hidden;
      background: #000;
      font-family: sans-serif;
    }
    canvas {
      display: block;
    }
  </style>
</head>
<body>
  <canvas id="gameCanvas"></canvas>
  <script>
    // Canvas und Kontext einrichten
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;

    // Globale Variablen und Arrays
    const keys = {};
    let mouse = { x: canvas.width / 2, y: canvas.height / 2 };
    let bullets = [];
    let enemies = [];
    let particles = [];
    let powerUps = [];
    let score = 0;
    let gameOver = false;
    let paused = false;
    let enemySpawnTimer = 0;
    let enemySpawnInterval = 120; // in Frames
    let difficultyTimer = 0;
    let shootCooldownTimer = 0; // Frames bis zum nächsten Schuss

    // High Score aus localStorage laden
    let highScore = localStorage.getItem("highScore") ? parseInt(localStorage.getItem("highScore")) : 0;

    // Spieler-Objekt
    const player = {
      x: canvas.width / 2,
      y: canvas.height / 2,
      radius: 20,
      speed: 4,
      angle: 0,
      health: 3
    };
    const maxHealth = 5; // Maximale Gesundheit

    // Dash-Mechanik
    let isDashing = false;
    let dashTimer = 0;
    let dashCooldown = 0;
    const dashDuration = 10;    // Dauer des Dash (in Frames)
    const dashCooldownMax = 60; // Cooldown nach dem Dash (in Frames)
    const dashMultiplier = 3;   // Multiplikator für die Bewegungsgeschwindigkeit während des Dash

    // Event-Listener für Tastatur und Maus
    window.addEventListener('keydown', e => {
      const key = e.key.toLowerCase();
      keys[key] = true;
      
      // Neustart bei Game Over: Taste R
      if (gameOver && key === 'r') {
        restartGame();
      }
      // Pause/Unpause: Taste P
      if (!gameOver && key === 'p') {
        paused = !paused;
      }
      // Starte Dash, wenn Shift gedrückt wird, Dash nicht aktiv ist und kein Cooldown besteht
      if (!isDashing && dashCooldown <= 0 && key === 'shift') {
        isDashing = true;
        dashTimer = dashDuration;
      }
    });
    window.addEventListener('keyup', e => {
      keys[e.key.toLowerCase()] = false;
    });
    canvas.addEventListener('mousemove', e => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
      player.angle = Math.atan2(mouse.y - player.y, mouse.x - player.x);
    });
    canvas.addEventListener('click', shootBullet);

    // Funktion zum Schießen (mit Cooldown)
    function shootBullet() {
      if (gameOver || paused) return;
      if (shootCooldownTimer > 0) return;
      const speed = 8;
      bullets.push({
        x: player.x,
        y: player.y,
        dx: Math.cos(player.angle) * speed,
        dy: Math.sin(player.angle) * speed,
        radius: 5
      });
      shootCooldownTimer = 15;
    }

    // Funktion zum Spawnen eines Gegners mit unterschiedlichen Typen
    function spawnEnemy() {
      let side = Math.floor(Math.random() * 4);
      let x, y;
      if (side === 0) {         // Oben
        x = Math.random() * canvas.width;
        y = -20;
      } else if (side === 1) {  // Rechts
        x = canvas.width + 20;
        y = Math.random() * canvas.height;
      } else if (side === 2) {  // Unten
        x = Math.random() * canvas.width;
        y = canvas.height + 20;
      } else {                  // Links
        x = -20;
        y = Math.random() * canvas.height;
      }

      let baseSpeed = 2 + Math.random() * 1.5 + (score / 100);
      let rand = Math.random();
      let type = "normal";
      let radius = 20;
      let speed = baseSpeed;
      // 10% Chance: Gegner vom Typ "splitter"
      if (rand < 0.1) {
        type = "splitter";
        radius = 25;
        speed = baseSpeed * 0.8;
      }
      // 20% Chance: Schneller Gegner
      else if (rand < 0.3) {
        type = "fast";
        radius = 15;
        speed = baseSpeed * 1.5;
      }
      enemies.push({ x, y, radius, speed, type });
    }

    // Funktion zum Spawnen eines Health-PowerUps
    function spawnPowerUp() {
      powerUps.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        radius: 10,
        life: 600,  // Lebensdauer in Frames
        alpha: 1
      });
    }

    // Erzeugt Gore-Partikel (Bluteffekt)
    function createGore(x, y) {
      const count = 20;
      for (let i = 0; i < count; i++) {
        particles.push({
          x: x,
          y: y,
          dx: (Math.random() - 0.5) * 6,
          dy: (Math.random() - 0.5) * 6,
          radius: Math.random() * 3 + 2,
          life: 60,
          alpha: 1
        });
      }
    }

    // Prüft die Kollision zwischen zwei Kreisen
    function circleCollision(x1, y1, r1, x2, y2, r2) {
      return Math.hypot(x1 - x2, y1 - y2) < r1 + r2;
    }

    // Update-Funktion für alle Spielobjekte
    function update() {
      if (gameOver || paused) return;

      // Dash-Logik (nur Timer aktualisieren, da der Start bereits im Keydown-Event erfolgt)
      if (isDashing) {
        dashTimer--;
        if (dashTimer <= 0) {
          isDashing = false;
          dashCooldown = dashCooldownMax;
        }
      } else {
        if (dashCooldown > 0) dashCooldown--;
      }

      // Bestimme die aktuelle Bewegungsgeschwindigkeit (mit Dash-Multiplikator)
      let currentSpeed = player.speed * (isDashing ? dashMultiplier : 1);

      // Spielerbewegung (nur WASD)
      if (keys['w']) { player.y -= currentSpeed; }
      if (keys['s']) { player.y += currentSpeed; }
      if (keys['a']) { player.x -= currentSpeed; }
      if (keys['d']) { player.x += currentSpeed; }
      // Spieler innerhalb des Canvas halten
      player.x = Math.max(player.radius, Math.min(canvas.width - player.radius, player.x));
      player.y = Math.max(player.radius, Math.min(canvas.height - player.radius, player.y));

      // Schuss-Cooldown verringern
      if (shootCooldownTimer > 0) shootCooldownTimer--;

      // Update der Kugeln
      for (let i = bullets.length - 1; i >= 0; i--) {
        let b = bullets[i];
        b.x += b.dx;
        b.y += b.dy;
        if (b.x < 0 || b.x > canvas.width || b.y < 0 || b.y > canvas.height) {
          bullets.splice(i, 1);
        }
      }

      // Update der Gegner
      for (let i = enemies.length - 1; i >= 0; i--) {
        let enemy = enemies[i];
        let angle = Math.atan2(player.y - enemy.y, player.x - enemy.x);
        enemy.x += Math.cos(angle) * enemy.speed;
        enemy.y += Math.sin(angle) * enemy.speed;

        // Kollision zwischen Gegner und Spieler
        if (circleCollision(enemy.x, enemy.y, enemy.radius, player.x, player.y, player.radius)) {
          player.health--;
          enemies.splice(i, 1);
          if (player.health <= 0) {
            gameOver = true;
            if (score > highScore) {
              highScore = score;
              localStorage.setItem("highScore", highScore);
            }
          }
          continue;
        }

        // Kollision zwischen Kugeln und Gegner
        for (let j = bullets.length - 1; j >= 0; j--) {
          let b = bullets[j];
          if (circleCollision(enemy.x, enemy.y, enemy.radius, b.x, b.y, b.radius)) {
            createGore(enemy.x, enemy.y);
            if (enemy.type === "splitter") {
              // Beim Abschuss eines Splitter-Gegners: Erzeuge zwei kleinere normale Gegner
              for (let k = 0; k < 2; k++) {
                enemies.push({
                  x: enemy.x,
                  y: enemy.y,
                  radius: 10,
                  speed: enemy.speed * 1.2,
                  type: "normal"
                });
              }
              score += 2;
            } else {
              score++;
            }
            enemies.splice(i, 1);
            bullets.splice(j, 1);
            break;
          }
        }
      }

      // Update der Partikel (Gore-Effekt)
      for (let i = particles.length - 1; i >= 0; i--) {
        let p = particles[i];
        p.x += p.dx;
        p.y += p.dy;
        p.life--;
        p.alpha = p.life / 60;
        if (p.life <= 0) {
          particles.splice(i, 1);
        }
      }

      // Gelegentlich Health-PowerUps spawnen
      if (Math.random() < 0.002) {
        spawnPowerUp();
      }
      // Update der PowerUps
      for (let i = powerUps.length - 1; i >= 0; i--) {
        let pu = powerUps[i];
        pu.life--;
        pu.alpha = pu.life / 600;
        // Bei Kollision mit dem Spieler: Health erhöhen (bis maxHealth)
        if (circleCollision(player.x, player.y, player.radius, pu.x, pu.y, pu.radius)) {
          if (player.health < maxHealth) {
            player.health++;
          }
          powerUps.splice(i, 1);
          continue;
        }
        if (pu.life <= 0) {
          powerUps.splice(i, 1);
        }
      }

      // Erhöhe den Schwierigkeitsgrad über die Zeit
      difficultyTimer++;
      if (difficultyTimer % 600 === 0 && enemySpawnInterval > 30) {
        enemySpawnInterval -= 10;
      }
      // Gegner spawnen
      enemySpawnTimer++;
      if (enemySpawnTimer > enemySpawnInterval) {
        spawnEnemy();
        enemySpawnTimer = 0;
      }
    }

    // Zeichnet einen Hintergrund mit Farbverlauf
    function drawBackground() {
      let gradient = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
      gradient.addColorStop(0, "#111");
      gradient.addColorStop(1, "#333");
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }

    // Zeichnet alle Spielobjekte und das HUD
    function draw() {
      drawBackground();

      // Kugeln zeichnen
      ctx.fillStyle = "#ff0";
      bullets.forEach(b => {
        ctx.beginPath();
        ctx.arc(b.x, b.y, b.radius, 0, Math.PI * 2);
        ctx.fill();
      });

      // Gegner zeichnen (Farbkodierung: normal = Rot, fast = Magenta, splitter = Cyan)
      enemies.forEach(enemy => {
        ctx.beginPath();
        ctx.arc(enemy.x, enemy.y, enemy.radius, 0, Math.PI * 2);
        if (enemy.type === "fast") {
          ctx.fillStyle = "#f0f";
        } else if (enemy.type === "splitter") {
          ctx.fillStyle = "#0ff";
        } else {
          ctx.fillStyle = "#f00";
        }
        ctx.fill();
      });

      // Partikel (Gore-Effekt) zeichnen
      particles.forEach(p => {
        ctx.fillStyle = `rgba(150, 0, 0, ${p.alpha})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fill();
      });

      // PowerUps zeichnen (grüne Kreise mit weißem Rand)
      powerUps.forEach(pu => {
        ctx.fillStyle = `rgba(0,255,0,${pu.alpha})`;
        ctx.beginPath();
        ctx.arc(pu.x, pu.y, pu.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = "#fff";
        ctx.stroke();
      });

      // Spieler zeichnen (weiße Dreiecksform)
      ctx.save();
      ctx.translate(player.x, player.y);
      ctx.rotate(player.angle);
      ctx.fillStyle = "#fff";
      ctx.beginPath();
      ctx.moveTo(20, 0);
      ctx.lineTo(-15, 12);
      ctx.lineTo(-15, -12);
      ctx.closePath();
      ctx.fill();
      ctx.restore();

      // HUD-Anzeige
      ctx.fillStyle = "#fff";
      ctx.font = "20px Arial";
      ctx.textAlign = "left";
      ctx.fillText("Score: " + score, 20, 30);
      ctx.fillText("High Score: " + highScore, 20, 60);
      ctx.fillText("Health: " + player.health, 20, 90);
      let dashStatus = isDashing
        ? "Dashing"
        : (dashCooldown > 0 ? "Dash Cooldown: " + dashCooldown : "Dash: Ready");
      ctx.fillText(dashStatus, 20, 120);
      ctx.fillText("Press 'P' to pause", 20, 150);

      // Anzeige bei Pause
      if (paused && !gameOver) {
        ctx.fillStyle = "rgba(0,0,0,0.7)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = "#fff";
        ctx.font = "50px Arial";
        ctx.textAlign = "center";
        ctx.fillText("PAUSED", canvas.width / 2, canvas.height / 2);
      }

      // Game Over Anzeige
      if (gameOver) {
        ctx.fillStyle = "rgba(0,0,0,0.8)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = "#fff";
        ctx.font = "50px Arial";
        ctx.textAlign = "center";
        ctx.fillText("GAME OVER", canvas.width / 2, canvas.height / 2 - 30);
        ctx.font = "30px Arial";
        ctx.fillText("Press 'R' to restart", canvas.width / 2, canvas.height / 2 + 20);
      }
    }

    // Hauptspielschleife
    function gameLoop() {
      update();
      draw();
      requestAnimationFrame(gameLoop);
    }

    // Spiel zurücksetzen
    function restartGame() {
      score = 0;
      gameOver = false;
      paused = false;
      bullets = [];
      enemies = [];
      particles = [];
      powerUps = [];
      enemySpawnTimer = 0;
      enemySpawnInterval = 120;
      difficultyTimer = 0;
      shootCooldownTimer = 0;
      isDashing = false;
      dashTimer = 0;
      dashCooldown = 0;
      player.x = canvas.width / 2;
      player.y = canvas.height / 2;
      player.health = 3;
    }

    gameLoop();

    // Bei Fenstergrößenänderung das Canvas anpassen
    window.addEventListener('resize', () => {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    });
  </script>
</body>
</html>
